-- Desafio 1: Qual o faturamento (já pago) gerado por cada veterinário?
-- (JOIN + GROUP BY + SUM + AVG)
SELECT v.nome AS veterinario,
       COUNT(co.id_consulta) AS consultas_pagas,
       SUM(pg.valor)         AS faturamento,
       AVG(pg.valor)         AS ticket_medio
FROM pagamentos pg
JOIN consultas co    ON co.id_consulta = pg.id_consulta
JOIN veterinarios v  ON v.id_veterinario = co.id_veterinario
WHERE pg.status = 'Pago'
GROUP BY v.id_veterinario, v.nome
ORDER BY faturamento DESC;

-- Desafio 2: Quais clientes estão com pagamento pendente e quanto devem?
-- (útil para o setor de cobrança - JOIN em 4 tabelas)
SELECT c.nome AS cliente, c.telefone, a.nome AS animal,
       co.data_consulta, pg.valor AS valor_pendente
FROM pagamentos pg
JOIN consultas co ON co.id_consulta = pg.id_consulta
JOIN animais a    ON a.id_animal = co.id_animal
JOIN clientes c   ON c.id_cliente = a.id_cliente
WHERE pg.status = 'Pendente'
ORDER BY co.data_consulta;

-- Desafio 3: Quais são os medicamentos mais prescritos pela clínica?
-- (JOIN + GROUP BY + HAVING + COUNT/SUM)
SELECT m.nome AS medicamento, m.fabricante,
       COUNT(ip.id_prescricao) AS vezes_prescrito,
       SUM(ip.quantidade)      AS unidades_prescritas
FROM medicamentos m
JOIN itens_prescricao ip ON ip.id_medicamento = m.id_medicamento
GROUP BY m.id_medicamento, m.nome, m.fabricante
HAVING COUNT(ip.id_prescricao) >= 3
ORDER BY vezes_prescrito DESC, unidades_prescritas DESC;