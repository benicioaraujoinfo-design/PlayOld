-- 5. CONSUL-- =====================================================================TAS SQL
-- =====================================================================

-- ------------------------- CONSULTAS BÁSICAS -------------------------
-- a) Todos os clientes
SELECT * FROM clientes;

-- b) Animais de um determinado cliente
SELECT a.id_animal, a.nome, a.data_nascimento, a.sexo, a.peso
FROM animais a
JOIN clientes c ON c.id_cliente = a.id_cliente
WHERE c.nome = 'Carlos Silva';

-- c) Veterinários cadastrados
SELECT id_veterinario, nome, crmv, telefone, email, data_contratacao
FROM veterinarios
ORDER BY nome;

-- d) Procedimentos com valor superior a determinado valor
SELECT id_procedimento, nome, valor_padrao
FROM procedimentos
WHERE valor_padrao > 100
ORDER BY valor_padrao DESC;

-- e) Medicamentos de determinado fabricante
SELECT id_medicamento, nome, principio_ativo, apresentacao, preco
FROM medicamentos
WHERE fabricante = 'Ourofino';

-- ---------------------------- JOIN ----------------------------------
-- f) Animal, proprietário e espécie
SELECT a.nome AS animal, c.nome AS proprietario, e.nome_especie AS especie
FROM animais a
JOIN clientes c ON c.id_cliente = a.id_cliente
JOIN especies e ON e.id_especie = a.id_especie
ORDER BY a.nome;

-- g) Consultas: data, horário, animal, proprietário e veterinário
SELECT co.data_consulta, co.horario,
       a.nome  AS animal,
       c.nome  AS proprietario,
       v.nome  AS veterinario
FROM consultas co
JOIN animais a       ON a.id_animal = co.id_animal
JOIN clientes c      ON c.id_cliente = a.id_cliente
JOIN veterinarios v  ON v.id_veterinario = co.id_veterinario
ORDER BY co.data_consulta, co.horario;

-- h) Veterinários e suas especialidades
SELECT v.nome AS veterinario, es.nome AS especialidade
FROM veterinarios v
JOIN veterinario_especialidade ve ON ve.id_veterinario = v.id_veterinario
JOIN especialidades es            ON es.id_especialidade = ve.id_especialidade
ORDER BY v.nome, es.nome;

-- i) Procedimentos realizados em cada consulta
SELECT co.id_consulta, co.data_consulta, a.nome AS animal,
       p.nome AS procedimento, cp.quantidade, cp.valor_cobrado
FROM consultas co
JOIN animais a                ON a.id_animal = co.id_animal
JOIN consulta_procedimento cp ON cp.id_consulta = co.id_consulta
JOIN procedimentos p          ON p.id_procedimento = cp.id_procedimento
ORDER BY co.id_consulta, p.nome;

-- j) Medicamentos prescritos para determinado animal
SELECT a.nome AS animal, co.data_consulta, m.nome AS medicamento,
       ip.dosagem, ip.frequencia, ip.duracao_tratamento
FROM animais a
JOIN consultas co        ON co.id_animal = a.id_animal
JOIN prescricoes pr      ON pr.id_consulta = co.id_consulta
JOIN itens_prescricao ip ON ip.id_prescricao = pr.id_prescricao
JOIN medicamentos m      ON m.id_medicamento = ip.id_medicamento
WHERE a.nome = 'Thor'
ORDER BY co.data_consulta;

-- -------------------------- LEFT JOIN -------------------------------
-- k) Todos os veterinários, inclusive os sem consultas
SELECT v.nome AS veterinario, COUNT(co.id_consulta) AS total_consultas
FROM veterinarios v
LEFT JOIN consultas co ON co.id_veterinario = v.id_veterinario
GROUP BY v.id_veterinario, v.nome
ORDER BY total_consultas DESC;

-- l) Todos os procedimentos, inclusive os nunca utilizados
SELECT p.nome AS procedimento, COUNT(cp.id_consulta) AS vezes_realizado
FROM procedimentos p
LEFT JOIN consulta_procedimento cp ON cp.id_procedimento = p.id_procedimento
GROUP BY p.id_procedimento, p.nome
ORDER BY vezes_realizado DESC;

-- m) Todos os clientes, inclusive os sem animais
SELECT c.nome AS cliente, COUNT(a.id_animal) AS total_animais
FROM clientes c
LEFT JOIN animais a ON a.id_cliente = c.id_cliente
GROUP BY c.id_cliente, c.nome
ORDER BY total_animais DESC;

-- -------------------------- GROUP BY --------------------------------
-- n) Quantidade de animais por espécie
SELECT e.nome_especie AS especie, COUNT(a.id_animal) AS total_animais
FROM especies e
LEFT JOIN animais a ON a.id_especie = e.id_especie
GROUP BY e.id_especie, e.nome_especie;

-- o) Quantidade de consultas por veterinário
SELECT v.nome AS veterinario, COUNT(co.id_consulta) AS total_consultas
FROM veterinarios v
JOIN consultas co ON co.id_veterinario = v.id_veterinario
GROUP BY v.id_veterinario, v.nome
ORDER BY total_consultas DESC;

-- p) Quantidade de consultas por mês
SELECT DATE_FORMAT(data_consulta, '%Y-%m') AS mes, COUNT(*) AS total_consultas
FROM consultas
GROUP BY DATE_FORMAT(data_consulta, '%Y-%m')
ORDER BY mes;

-- q) Valor total recebido pela clínica por forma de pagamento (apenas pagos)
SELECT forma_pagamento, SUM(valor) AS total_recebido
FROM pagamentos
WHERE status = 'Pago'
GROUP BY forma_pagamento
ORDER BY total_recebido DESC;

-- --------------------------- HAVING ---------------------------------
-- r) Veterinários com mais de 3 consultas
SELECT v.nome AS veterinario, COUNT(co.id_consulta) AS total_consultas
FROM veterinarios v
JOIN consultas co ON co.id_veterinario = v.id_veterinario
GROUP BY v.id_veterinario, v.nome
HAVING COUNT(co.id_consulta) > 3;

-- s) Espécies com mais de 3 animais
SELECT e.nome_especie AS especie, COUNT(a.id_animal) AS total_animais
FROM especies e
JOIN animais a ON a.id_especie = e.id_especie
GROUP BY e.id_especie, e.nome_especie
HAVING COUNT(a.id_animal) > 3;

-- t) Procedimentos realizados mais de 5 vezes
SELECT p.nome AS procedimento, COUNT(cp.id_consulta) AS vezes_realizado
FROM procedimentos p
JOIN consulta_procedimento cp ON cp.id_procedimento = p.id_procedimento
GROUP BY p.id_procedimento, p.nome
HAVING COUNT(cp.id_consulta) > 5;

-- --------------------- FUNÇÕES DE AGREGAÇÃO -------------------------
-- COUNT, SUM, AVG, MAX e MIN sobre os pagamentos efetivamente pagos
SELECT COUNT(*)   AS qtd_pagamentos,
       SUM(valor) AS faturamento_total,
       AVG(valor) AS ticket_medio,
       MAX(valor) AS maior_pagamento,
       MIN(valor) AS menor_pagamento
FROM pagamentos
WHERE status = 'Pago';

-- MAX / MIN / AVG sobre os procedimentos
SELECT MAX(valor_padrao) AS procedimento_mais_caro,
       MIN(valor_padrao) AS procedimento_mais_barato,
       AVG(valor_padrao) AS valor_medio
FROM procedimentos;

